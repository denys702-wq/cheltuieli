rules_version = '2';
// Reguli propuse pentru Firestore, deduse din cum folosește aplicația datele (app.js).
// NU sunt testate cu emulatorul Firebase: verifică-le în consola Firebase (Rules Playground)
// și testează crearea căminului, intrarea cu cod și sincronizarea înainte de publicare.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function home(hid) { return /databases/$(database)/documents/households/$(hid); }
    // getAfter: vede și scrierile din același batch (ex. cămin creat + invitație)
    function memberAfter(hid) { return signedIn() && request.auth.uid in getAfter(home(hid)).data.members; }

    // profilul propriu: doar tu îl citești și îl scrii
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // invitații: se citesc doar după cod exact (fără listare), se creează doar pentru căminul propriu
    match /invites/{code} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn() && memberAfter(request.resource.data.hid);
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        // membrii își pot edita căminul, dar lista de membri nu poate crește peste 2
        (request.auth.uid in resource.data.members && request.resource.data.members.size() <= 2)
        // un nou partener se poate adăuga singur, dacă mai e loc și nu scoate pe nimeni
        || (resource.data.members.size() < 2
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.size() <= 2
            && request.resource.data.members.hasAll(resource.data.members))
      );
      allow delete: if false;

      // tranzacții, bugete, reguli etc. — doar membrii căminului
      match /{coll}/{id} {
        allow read, write: if memberAfter(hid);
      }
    }

    // raport de erori: doar scriere, doar cu uid-ul propriu, fără citire
    match /errors/{id} {
      allow create, update: if signedIn() && request.resource.data.u == request.auth.uid;
      allow read, delete: if false;
    }

    // orice altceva e închis
    match /{document=**} { allow read, write: if false; }
  }
}
